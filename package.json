{
  "name": "focus-todo",
  "version": "1.1.0",
  "description": "一个只存在于本机的简洁桌面待办应用",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "keywords": [
    "todo",
    "electron",
    "desktop",
    "portfolio"
  ],
  "author": "zcm08042",
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.zcm08042.focustodo",
    "productName": "Focus Todo",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "allowScripts": {
    "electron@33.4.11": true
  }
}
